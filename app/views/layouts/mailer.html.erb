<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body { font-family: Georgia, serif; color: #1b2d5e; line-height: 1.5; }
      .wrap { max-width: 560px; margin: 0 auto; padding: 24px; }
      .brand { color: #c8991a; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; font-size: 12px; }
